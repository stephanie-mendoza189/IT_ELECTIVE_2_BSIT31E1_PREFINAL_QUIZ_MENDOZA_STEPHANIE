@{
    ViewData["Title"] = "Login - Portfolio";
}

<div class="desktop-container">
    <div class="login-card">
        <h1> Welcome to my portfolio</h1>
        <p>Please login first to access my portfolio projects.</p>

        <form method="post" action="/Home/Login">
            <input type="text" name="username" placeholder="Enter Username" required /><br /><br />
            <input type="password" name="password" placeholder="Enter Password" required /><br /><br />
            <button type="submit" class="pink-btn">Login</button>
        </form>

        <p style="color: #ff477e; margin-top: 15px;"><b>@ViewBag.Error</b></p>
    </div>
</div>

<style>
    body {
        background-color: #0c101d;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #f4edd3;
        margin: 0;
        padding: 0;
    }

    .desktop-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .login-card {
        background: #151b2b;
        padding: 40px;
        border-radius: 16px;
        border: 2px solid #ff70a6;
        box-shadow: 0 10px 30px rgba(255, 112, 166, 0.2);
        text-align: center;
        width: 400px;
    }

    input {
        width: 90%;
        padding: 12px;
        background: #0c101d;
        border: 2px solid #ff70a6;
        border-radius: 8px;
        color: white;
        font-size: 14px;
    }

    .pink-btn {
        background-color: #ff477e;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        font-size: 16px;
        transition: 0.2s;
    }

        .pink-btn:hover {
            background-color: #ff70a6;
        }
</style>