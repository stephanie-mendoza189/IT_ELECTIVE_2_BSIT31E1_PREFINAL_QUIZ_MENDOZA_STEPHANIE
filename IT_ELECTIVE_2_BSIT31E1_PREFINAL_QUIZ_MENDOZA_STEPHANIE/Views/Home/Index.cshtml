@{
    ViewData["Title"] = "Login - Portfolio";
}

<div class="browser-window">
    <div class="top-bar">
        <span class="dots">🔴 🟡 🟢</span>
        <span class="url">https://login.com</span>
    </div>
    <div class="content-box">
        <h2>Please Login First to Access Projects</h2>

        <form method="post" action="/Home/Login">
            <input type="text" name="username" placeholder="Enter Username" required /><br /><br />
            <input type="password" name="password" placeholder="Enter Password" required /><br /><br />
            <button type="submit" class="btn-green">Login</button>
        </form>

        <p style="color: #b7410e;"><b>@ViewBag.Error</b></p>
    </div>
</div>

<style>
    body {
        background-color: #f4edd3;
        font-family: 'Comic Sans MS', cursive, sans-serif;
        color: #4a3b32;
        text-align: center;
    }

    .browser-window {
        max-width: 450px;
        margin: 30px auto;
        background: #fffaf0;
        border: 3px solid #8fbc8f;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .top-bar {
        background: #e6dfc8;
        padding: 8px;
        text-align: left;
        font-size: 12px;
        border-bottom: 2px solid #8fbc8f;
    }

    .content-box {
        padding: 25px;
    }

    input {
        padding: 8px;
        width: 80%;
        border: 2px solid #a2d2ff;
        border-radius: 8px;
        background: #fdfcf7;
    }

    .btn-green {
        background-color: #8fbc8f;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-green:hover {
            background-color: #769b76;
        }
</style>