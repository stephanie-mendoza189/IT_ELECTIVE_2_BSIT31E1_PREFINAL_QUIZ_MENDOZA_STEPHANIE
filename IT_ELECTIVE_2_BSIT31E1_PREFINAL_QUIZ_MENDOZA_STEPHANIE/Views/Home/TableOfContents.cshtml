<style>
    body {
        background-color: #0c101d;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #f4edd3;
        margin: 0;
    }

    .full-page {
        min-height: 100vh;
        padding-bottom: 50px;
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 50px;
        background: #151b2b;
        border-bottom: 2px solid #ff70a6;
    }

    .logo {
        font-weight: bold;
        color: #ff70a6;
        font-size: 18px;
    }

    .nav-links a {
        color: #f4edd3;
        text-decoration: none;
        margin-left: 20px;
        font-weight: bold;
    }

        .nav-links a:hover {
            color: #ff70a6;
        }

    .content-wrapper {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .header-prototype-box {
        background: #151b2b;
        border: 2px dashed #ff70a6;
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .main-title {
        color: #ff70a6;
        font-size: 28px;
        margin-bottom: 5px;
        margin-top: 0;
    }

    .subtitle {
        color: #a0aabf;
        margin: 0;
        font-size: 14px;
    }

    .category-box {
        background: #151b2b;
        padding: 25px 30px;
        border-radius: 16px;
        border: 1px solid #2a3450;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #2a3450;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

    .category-box h2 {
        color: #ff70a6;
        font-size: 20px;
        margin: 0;
    }

    .wireframe-badge {
        font-size: 12px;
        background: #0c101d;
        color: #ff70a6;
        border: 1px dashed #ff70a6;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: bold;
    }

    .project-grid-proto {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .proto-card {
        display: flex;
        align-items: center;
        background: #0c101d;
        border: 1px solid #2a3450;
        padding: 14px 18px;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
    }

        .proto-card:hover {
            border-color: #ff70a6;
            transform: translateX(4px);
            background: #121829;
        }

    .proto-tag {
        background: rgba(255, 112, 166, 0.1);
        color: #ff70a6;
        font-size: 11px;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 6px;
        margin-right: 15px;
        border: 1px dashed #ff70a6;
        min-width: 45px;
        text-align: center;
    }

    .proto-title {
        color: #f4edd3;
        font-size: 14px;
        font-weight: 500;
        word-break: break-all;
    }

    .exam-card {
        border-left: 4px solid #ff477e;
    }
</style>